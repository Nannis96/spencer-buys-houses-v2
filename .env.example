# Public phone variables (safe to commit)
# NEXT_PUBLIC_PHONE_NUMBER="+19016218799"
# NEXT_PUBLIC_PHONE_DISPLAY="(901) 621-8799"

# Usage: copy these values into your local `.env.local` or CI environment# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Rentcast API — https://developers.rentcast.io
RENTCAST_API_KEY=

# Database
DATABASE_URL=

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Secret used to sign external API tokens (POST /api/auth/token)
# If omitted, falls back to NEXTAUTH_SECRET
API_JWT_SECRET=

# AWS S3 — https://s3.console.aws.amazon.com
# NUNCA uses el prefijo NEXT_PUBLIC_ en estas variables: deben permanecer solo en el servidor
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=