// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// prisma/schema.prisma

generator client {
    provider = "prisma-client"
    output   = "../app/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// --- ENUMS & STUBS FALTANTES ---
enum Role {
    USER
    ADMIN
}

// --- TUS MODELOS ---
model User {
    id            String    @id @default(cuid())
    name          String?
    email         String    @unique
    emailVerified DateTime?
    image         String?
    password      String
    role          Role      @default(USER)
    accounts      Account[]
    sessions      Session[]
    apiTokens     ApiToken[]
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
}

model Account {
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String?
    access_token      String?
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String?
    session_state     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([provider, providerAccountId])
}

model Session {
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model VerificationToken {
    identifier String
    token      String
    expires    DateTime

    @@id([identifier, token])
}

model Post {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    slug        String  @unique

    // Contenido Principal
    title   String
    content String @db.Text // Puede ser Markdown o HTML

    // Multimedia Principal
    mainImage String?

    // --- Imágenes Inline del Post [NUEVO] ---
    postImages PostImage[]

    // --- Sección de Autor / Bio por Post [NUEVO] ---
    authorName  String?
    authorImage String?
    authorBio   String? @db.Text

    // --- SEO Avanzado [ACTUALIZADO] ---
    seoTitle     String?
    seoDesc      String?
    focusKeyword String? // Keyword principal
    json_ld      String? @db.Text // Structured Data (JSON-LD o script HTML)

    // --- Clasificación y estado ---
    category String  @default("general")
    status   String  @default("draft")

}

model PostImage {
    id      String  @id @default(cuid())
    url     String
    altText String?

    postId String
    post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Service {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    slug    String @unique

    // Main Content
    title   String
    content String @db.Text

    // Main Media
    mainImage String?

    // Inline Images
    serviceImages ServiceImage[]

    // Author / Bio
    authorName  String?
    authorImage String?
    authorBio   String? @db.Text

    // Advanced SEO
    seoTitle     String?
    seoDesc      String?
    focusKeyword String?

    // Classification
    category String @default("general")
    status   String @default("draft")
}

model ServiceImage {
    id      String  @id @default(cuid())
    url     String
    altText String?

    serviceId String
    service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

// API Tokens for external integrations
model ApiToken {
    id        String   @id @default(cuid())
    userId    String
    token     String   @unique
    audience  String   @default("external")
    revoked   Boolean  @default(false)
    createdAt DateTime @default(now())
    expiresAt DateTime

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}
